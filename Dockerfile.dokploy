# OpenWA - Single Container Dockerfile for Dokploy (Application type)
# Builds API + Dashboard + Nginx in one image
# Nginx on port 80 proxies /api/* to API on localhost:2785, serves dashboard SPA

# ===== Stage 1: Build API =====
FROM node:22-slim AS api-builder

WORKDIR /app

RUN apt-get update && apt-get install -y \
    python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

COPY package*.json ./

RUN npm ci

COPY . .

RUN npm run build

# ===== Stage 2: Build Dashboard =====
FROM node:22-alpine AS dash-builder

WORKDIR /app

COPY dashboard/package*.json dashboard/.npmrc ./

RUN npm ci

COPY dashboard/ .

RUN npx vite build

# ===== Stage 3: Production =====
FROM node:22-slim

RUN apt-get update && apt-get install -y \
    chromium fonts-liberation libappindicator3-1 libasound2 \
    libatk-bridge2.0-0 libatk1.0-0 libcups2 libdbus-1-3 \
    libdrm2 libgbm1 libgtk-3-0 libnspr4 libnss3 libx11-xcb1 \
    libxcomposite1 libxdamage1 libxrandr2 xdg-utils dumb-init \
    nginx-light \
    && rm -rf /var/lib/apt/lists/*

ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

WORKDIR /app

# API runtime
COPY --from=api-builder /app/package*.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=api-builder /app/dist ./dist

# Dashboard static files
COPY --from=dash-builder /app/dist /usr/share/nginx/html

# Nginx config
COPY nginx-dokploy.conf /etc/nginx/conf.d/default.conf

# Data directories
RUN mkdir -p /app/data/sessions /app/data/media

# Startup script
COPY start.sh /
RUN chmod +x /start.sh

EXPOSE 80

ENTRYPOINT ["dumb-init", "--"]
CMD ["/start.sh"]
